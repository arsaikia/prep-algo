# Optional offline migration source; the runtime does not connect to MongoDB.
# Import is dry-run unless explicitly passed --apply.
# IMPORT_MONGO_URI=mongodb+srv://your_migration_source

# Neon pooled development connection used by the app and db:check.
# Keep the connection string's SSL parameters from the Neon console.
DATABASE_URL=postgresql://your_dev_role:your_password@your-dev-host-pooler.neon.tech/neondb?sslmode=verify-full

# Optional integration-test database (tests create and remove isolated schemas).
# TEST_DATABASE_URL=postgresql://your_test_role:your_password@your-test-host.neon.tech/neondb?sslmode=verify-full

# Environment settings
NODE_ENV=development
PORT=5000
BASE_URI=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Redis (Upstash serverless — optional, falls back to in-memory)
REDIS_URL=redis://default:your_password@your-endpoint.upstash.io:6379

# GitHub (if needed)
GITHUB_TOKEN=your_github_token_here

# Production API: calls an independent Docker-capable executor with a Google
# service-account ID token. Without this URL, production execution returns 503.
# Never put database/Redis/JWT secrets on the executor host.
# CODE_EXECUTOR_URL=https://executor.example.com
# CODE_EXECUTOR_AUDIENCE=https://executor.example.com

# Local development only (see docs/adr/008-code-execution-sandbox.md)
# docker — kernel-enforced per-program limits; requires a Docker daemon
# subprocess/auto — local hardening, NOT tenant isolation
CODE_SANDBOX_MODE=auto
CODE_SANDBOX_IMAGE=python:3.11-alpine
CODE_SANDBOX_TIMEOUT_MS=5000
CODE_SANDBOX_MEMORY_MB=256
# Programs run at once per process; the rest queue. Each may use MEMORY_MB, so
# keep MAX_CONCURRENT x MEMORY_MB + ~150MB for Node under the container limit.
CODE_SANDBOX_MAX_CONCURRENT=1

# All execution routes share one active submission, eight waiting slots, a 2s
# queue ceiling and a 15s end-to-end deadline per API process.
# Colocated CODE_EXECUTION_QUEUE=bullmq is retired and fails startup explicitly.

# Pool budget includes all instances AND overlapping candidates/rollouts:
# PG_POOL_MAX=5
# CONTENT_CATALOG_SYNC=false is for release-managed catalog publication only.
