# MongoDB Atlas connection string
MONGO_URI=your_mongodb_uri_here

# Development MongoDB URI (if needed)
MONGO_URI_DEV=your_dev_mongodb_uri_here

# Environment settings
NODE_ENV=development
PORT=5000
BASE_URI=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Redis (Upstash serverless — optional, falls back to in-memory)
REDIS_URL=redis://default:your_password@your-endpoint.upstash.io:6379

# GitHub (if needed)
GITHUB_TOKEN=your_github_token_here

# Code execution sandbox (see docs/adr/008-code-execution-sandbox.md)
# docker     — full isolation; the intended production setting
# subprocess — hardened, but no kernel-level network guarantee; local dev only
# auto       — prefer docker, fall back to subprocess and warn loudly
CODE_SANDBOX_MODE=auto
CODE_SANDBOX_IMAGE=python:3.11-alpine
CODE_SANDBOX_TIMEOUT_MS=5000
CODE_SANDBOX_MEMORY_MB=256
# Programs run at once per process; the rest queue. Each may use MEMORY_MB, so
# keep MAX_CONCURRENT x MEMORY_MB + ~150MB for Node under the container limit.
CODE_SANDBOX_MAX_CONCURRENT=1

# Run code through the BullMQ queue instead of in the request. Off unless set to
# `bullmq`: the worker runs in the same container anyway, and its blocking polls
# spend a metered Redis plan's commands while idle. Needs REDIS_URL.
# CODE_EXECUTION_QUEUE=bullmq
