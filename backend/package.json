{
    "name": "prep-algo-backend",
    "version": "1.0.0",
    "description": "Backend service for Prep Algo application",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "executor": "node executor/server.js",
        "test": "node --test \"tests/**/*.test.js\"",
        "db:check": "node scripts/checkPostgres.js",
        "db:migrate": "node scripts/migratePostgres.js",
        "db:migrate:status": "node scripts/migratePostgres.js --status",
        "db:import-mongo": "node scripts/importMongoToPostgres.js",
        "validate-recommendations": "node scripts/validateRecommendationEngine.js",
        "validate-recommendations:verbose": "node scripts/validateRecommendationEngine.js --verbose"
    },
    "dependencies": {
        "axios": "^1.10.0",
        "bullmq": "^6.3.9",
        "compression": "^1.8.0",
        "cors": "^2.8.5",
        "dotenv": "^8.2.0",
        "express": "^4.17.1",
        "google-auth-library": "^9.15.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "node-cache": "^5.1.2",
        "pg": "^8.16.3",
        "pino": "^10.3.1",
        "uuid": "^8.3.2",
        "validator": "^13.9.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "mongoose": "^7.6.3",
        "eslint": "^8.43.0",
        "eslint-config-airbnb": "^19.0.4",
        "nodemon": "^2.0.6",
        "pino-pretty": "^13.1.3"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
