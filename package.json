{
  "name": "prep-algo",
  "version": "1.0.0",
  "description": "A platform for practicing algorithm problems with code execution and test cases",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "build:content": "node scripts/content/build.mjs",
    "server": "cd backend && nodemon --experimental-json-modules server.js",
    "client": "npm run build:content && cd frontend && npm run dev",
    "start": "cd backend && node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-server": "cd backend && npm install",
    "start-server": "cd backend && node server.js",
    "install-client": "cd frontend && npm install",
    "build-client": "npm run build:content && cd frontend && npm run build",
    "start-client": "cd frontend && npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsaikia/prep-algo.git"
  },
  "keywords": [
    "prep-algo",
    "algorithms",
    "coding-practice"
  ],
  "author": "Arunabh Saikia",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arsaikia/prep-algo/issues"
  },
  "homepage": "https://github.com/arsaikia/prep-algo#readme",
  "devDependencies": {
    "concurrently": "^5.3.0",
    "eslint": "^8.43.0",
    "eslint-config-airbnb": "^19.0.4",
    "jsdom": "^29.1.1",
    "nodemon": "^2.0.6",
    "zod": "^4.6.5"
  }
}
