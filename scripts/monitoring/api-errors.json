{
  "displayName": "PrepAlgo API 5xx",
  "documentation": {
    "content": "Inspect the failing Cloud Run revision and correlated request logs. Check PostgreSQL readiness and isolated executor availability. Roll back only to a PostgreSQL-compatible revision after cutover.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": ["projects/prepalgo/notificationChannels/REPLACE_ME"],
  "conditions": [{
    "displayName": "API returned a server error",
    "conditionMatchedLog": {
      "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"prep-algo-backend\" AND httpRequest.status>=500"
    }
  }],
  "alertStrategy": {
    "notificationRateLimit": {"period": "300s"},
    "autoClose": "1800s"
  }
}
